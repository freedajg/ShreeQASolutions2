{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun run test *)",
      "Bash(bun run build)",
      "Bash(supabase test db)",
      "Bash(git status)",
      "Bash(git diff *)",
      "PowerShell(bun run lint)",
      "PowerShell(bun run typecheck)",
      "PowerShell(bun run test *)",
      "PowerShell(bun run build)",
      "PowerShell(supabase test db)",
      "PowerShell(git status)",
      "PowerShell(git diff *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(bun add *)",
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets *)",
      "PowerShell(git push *)",
      "PowerShell(bun add *)",
      "PowerShell(supabase db push *)",
      "PowerShell(supabase functions deploy *)",
      "PowerShell(supabase secrets *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./supabase/.env)",
      "Read(./supabase/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./real-data/**)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push --force *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(supabase db reset --linked *)",
      "Bash(*.env*)",
      "Bash(*real-data*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(supabase db reset --linked *)",
      "PowerShell(*.env*)",
      "PowerShell(*real-data*)"
    ]
  }
}
