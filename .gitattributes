# Store and check out text files with LF on every OS, so Prettier and CI agree.
* text=auto eol=lf

# Git hooks are shell scripts; CRLF line endings would break them.
.githooks/* text eol=lf

# Binary files: never touch line endings or diff as text.
*.xlsx  binary
*.xls   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
